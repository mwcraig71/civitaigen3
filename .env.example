# Copy to .env and fill in. Never commit .env.

# --- Required ---

# PostgreSQL connection string (Neon)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional override used by some migration scripts
CUSTOM_DATABASE_URL=

# Express session signing secret. Generate: openssl rand -hex 32
SESSION_SECRET=

# Dedicated key for encrypting stored API keys (AES-256-GCM).
# MUST be 64 hex chars (32 bytes). Generate: openssl rand -hex 32
# Do NOT reuse SESSION_SECRET.
ENCRYPTION_KEY=

# --- Third-party APIs ---
CIVITAI_API_KEY=
REPLICATE_API_TOKEN=
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
DIFFUS_API_KEY=
AI_INTEGRATIONS_OPENROUTER_API_KEY=
AI_INTEGRATIONS_OPENROUTER_BASE_URL=
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENROUTER_API_KEY=

# --- Google OAuth (the only login method) ---
# Create an OAuth client at console.cloud.google.com -> Credentials.
# Register https://<each domain in APP_DOMAINS>/api/callback as an
# authorized redirect URI (plus http://localhost:5000/api/callback for dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Domains this app is served from (comma-separated)
APP_DOMAINS=civiverse.com,www.civiverse.com

# --- Hosting ---
PRODUCTION_DOMAIN=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# --- Web push (optional but recommended) ---
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@civiverse.com

# --- Optional ---
# Comma-separated allowed CORS origins for production
ALLOWED_ORIGINS=
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
TRANSFORM_IMG2IMG_COST=
TRANSFORM_IMG2VID_COST=
