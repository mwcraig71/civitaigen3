modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5199
externalPort = 3001

[[ports]]
localPort = 24678
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_log_in_with_replit:1.0.0", "javascript_stripe:1.0.0", "javascript_object_storage:2.0.0", "javascript_openrouter_ai_integrations:2.0.0", "javascript_openai_ai_integrations:2.0.0"]
stack = "FULLSTACK_JS"
expertMode = true

[objectStorage]
defaultBucketID = "replit-objstore-fb7f5c1f-bfb3-497f-8031-56c7b99cd0ce"

[userenv]

[userenv.shared]
ENCRYPTION_KEY = "bf822bc26057772534d975b300b02ed7e77717cff47dc19fa523dc698b1019d5"
PRIVATE_OBJECT_DIR = "/replit-objstore-fb7f5c1f-bfb3-497f-8031-56c7b99cd0ce/.private"
PUBLIC_OBJECT_SEARCH_PATHS = "/replit-objstore-fb7f5c1f-bfb3-497f-8031-56c7b99cd0ce/public"

[userenv.development]
APP_DOMAINS = "72bbe586-9bec-4142-8c99-fa9296ea5556-00-1zf6ihnub0nb2.janeway.replit.dev"

[userenv.production]
APP_DOMAINS = "civitaigen-3.replit.app"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
